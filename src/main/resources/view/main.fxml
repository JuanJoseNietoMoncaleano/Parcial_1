<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="10.0"
      stylesheets="@../css/styles.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.MainController">

    <children>
        <Label styleClass="titulo-seccion" text="RentCar - Sistema de Administración y Alquiler" />

        <TabPane prefHeight="600.0" prefWidth="880.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- PESTAÑA 1: CLIENTES Y NUMERO PERFECTO -->
                <Tab text="Clientes">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <Label styleClass="titulo-seccion" text="Registro de Cliente" />
                                <GridPane hgap="10.0" styleClass="panel-borde" vgap="8.0">
                                    <columnConstraints>
                                        <ColumnConstraints prefWidth="120.0" />
                                        <ColumnConstraints prefWidth="250.0" />
                                        <ColumnConstraints prefWidth="120.0" />
                                        <ColumnConstraints prefWidth="250.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Documento:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtDocumento" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Nombre Completo:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtNombre" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtTelefono" promptText="Ej: 6 o 28" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Correo:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtCorreo" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                        <Label text="Edad:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <TextField fx:id="txtEdad" promptText="Ej: 25" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                        <Button onAction="#registrarCliente" text="Registrar Cliente" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                                    </children>
                                </GridPane>

                                <Label styleClass="titulo-seccion" text="Consulta de Cliente y Teléfono Perfecto" />
                                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="panel-borde">
                                    <children>
                                        <Label text="Número de Teléfono:" />
                                        <TextField fx:id="txtBuscarTelefono" prefWidth="180.0" promptText="Ingrese teléfono a buscar" />
                                        <Button onAction="#consultarTelefonoPerfecto" text="Buscar y Validar Número" />
                                        <Label fx:id="lblResultadoPerfecto" text="Resultado: Sin consultar" />
                                    </children>
                                </HBox>

                                <TableView fx:id="tblClientes" prefHeight="220.0">
                                    <columns>
                                        <TableColumn fx:id="colDocCliente" prefWidth="120.0" text="Documento" />
                                        <TableColumn fx:id="colNombreCliente" prefWidth="200.0" text="Nombre" />
                                        <TableColumn fx:id="colTelCliente" prefWidth="130.0" text="Teléfono" />
                                        <TableColumn fx:id="colCorreoCliente" prefWidth="180.0" text="Correo" />
                                        <TableColumn fx:id="colEdadCliente" prefWidth="80.0" text="Edad" />
                                        <TableColumn fx:id="colFechaRegistro" prefWidth="130.0" text="Fecha Registro" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- PESTAÑA 2: NUEVA RESERVA Y LIQUIDACION -->
                <Tab text="Nueva Reserva">
                    <content>
                        <VBox spacing="10.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <GridPane hgap="10.0" styleClass="panel-borde" vgap="8.0">
                                    <columnConstraints>
                                        <ColumnConstraints prefWidth="130.0" />
                                        <ColumnConstraints prefWidth="280.0" />
                                        <ColumnConstraints prefWidth="130.0" />
                                        <ColumnConstraints prefWidth="280.0" />
                                    </columnConstraints>
                                    <children>
                                        <Label text="Código Reserva:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="txtCodigoReserva" promptText="Ej: RES-001" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Cliente Titular:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                        <ComboBox fx:id="cmbClientes" prefWidth="280.0" promptText="Seleccione Cliente" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                        <Label text="Vehículo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <ComboBox fx:id="cmbVehiculos" prefWidth="280.0" promptText="Seleccione Vehículo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Modalidad Alquiler:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                        <ComboBox fx:id="cmbModalidades" prefWidth="280.0" promptText="Seleccione Modalidad" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                        <Label text="Fecha Inicio:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <DatePicker fx:id="dpInicio" prefWidth="280.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                        <Label text="Fecha Fin:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                        <DatePicker fx:id="dpFin" prefWidth="280.0" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                                        <Label text="Descuento (%):" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                        <TextField fx:id="txtDescuento" promptText="Ej: 10" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                        <Label text="Servicios Extra:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                                        <HBox spacing="10.0" GridPane.columnIndex="3" GridPane.rowIndex="3">
                                            <children>
                                                <CheckBox fx:id="chkGps" text="GPS" />
                                                <CheckBox fx:id="chkSillaBebe" text="Silla Bebé" />
                                                <CheckBox fx:id="chkConductor" text="Conductor Adic." />
                                            </children>
                                        </HBox>
                                    </children>
                                </GridPane>

                                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="panel-borde">
                                    <children>
                                        <Button onAction="#crearReserva" text="Liquidary Guardar Reserva" />
                                        <Label fx:id="lblTotalLiquidado" text="Total Liquidado: $0.00" />
                                    </children>
                                </HBox>

                                <TableView fx:id="tblReservas" prefHeight="220.0">
                                    <columns>
                                        <TableColumn fx:id="colCodReserva" prefWidth="100.0" text="Código" />
                                        <TableColumn fx:id="colClienteReserva" prefWidth="170.0" text="Cliente" />
                                        <TableColumn fx:id="colVehiculoReserva" prefWidth="130.0" text="Vehículo" />
                                        <TableColumn fx:id="colModalidadReserva" prefWidth="140.0" text="Modalidad" />
                                        <TableColumn fx:id="colDiasReserva" prefWidth="60.0" text="Días" />
                                        <TableColumn fx:id="colInicioReserva" prefWidth="100.0" text="Inicio" />
                                        <TableColumn fx:id="colFinReserva" prefWidth="100.0" text="Fin" />
                                        <TableColumn fx:id="colTotalReserva" prefWidth="110.0" text="Total ($)" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>

                <!-- PESTAÑA 3: REPORTE DE INGRESOS -->
                <Tab text="Reporte de Ingresos">
                    <content>
                        <VBox spacing="12.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <Label styleClass="titulo-seccion" text="Consulta de Ingresos por Rango de Fechas" />
                                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="panel-borde">
                                    <children>
                                        <Label text="Desde:" />
                                        <DatePicker fx:id="dpReporteDesde" />
                                        <Label text="Hasta:" />
                                        <DatePicker fx:id="dpReporteHasta" />
                                        <Button onAction="#calcularIngresos" text="Calcular Ingresos" />
                                        <Label fx:id="lblResultadoIngresos" style="-fx-font-weight: bold;" text="Total Ingresos Periodo: $0.00" />
                                    </children>
                                </HBox>

                                <TableView fx:id="tblReporteReservas" prefHeight="380.0">
                                    <columns>
                                        <TableColumn fx:id="colRepCodigo" prefWidth="110.0" text="Código" />
                                        <TableColumn fx:id="colRepCliente" prefWidth="200.0" text="Cliente" />
                                        <TableColumn fx:id="colRepVehiculo" prefWidth="150.0" text="Vehículo" />
                                        <TableColumn fx:id="colRepFecha" prefWidth="120.0" text="Fecha Inicio" />
                                        <TableColumn fx:id="colRepTotal" prefWidth="140.0" text="Monto Generado" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</VBox>